#!/usr/bin/env python3
"""Run a BioFuzz campaign without installing the package.

Equivalent to the `biofuzz-fuzz` console script created by `pip install .`;
this wrapper just puts the repository on sys.path first so the checkout can be
run in place.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from biofuzz.cli.fuzz import main

if __name__ == "__main__":
    sys.exit(main())
