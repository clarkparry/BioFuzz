#!/usr/bin/env python3
"""Triage a BioFuzz campaign's findings without installing the package.

Equivalent to the `biofuzz-triage` console script created by `pip install .`.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from biofuzz.cli.triage import main

if __name__ == "__main__":
    sys.exit(main())
